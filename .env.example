# Copy this file to .env and fill in your values.
# The .env file is gitignored and passed to the api container via env_file.

# ── LLM providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── ElevenLabs TTS (used when tts_provider=elevenlabs) ────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_A=
ELEVENLABS_MODEL_ID=eleven_v3

# ── OpenRouter model alias ─────────────────────────────────────────────────────
OPENROUTER_PRO_MODEL=google/gemini-3-flash-preview:online

# ── Docker / deployment ────────────────────────────────────────────────────────
# Public port nginx listens on (default: 80)
PORT=80

# Coqui TTS device: cpu | cuda | mps (only used with --profile tts)
TORCH_DEVICE=cpu

# PyTorch wheel index for the tts service build (cpu by default)
# For CUDA 12.1: https://download.pytorch.org/whl/cu121
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
